      "name": "Channels"
    }
  ],
  "filters": [
     {
      "borderColor": "#FFFFFF",
      "groupId": "gq",
      "id": "q-r",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/remux-black.png",
      "isEnabled": true,
      "name": "Remux",
      "pattern": "(?i)\\bremux\\b",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gq",
      "id": "q-b",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/bluray-black.png",
      "isEnabled": true,
      "name": "BluRay",
      "pattern": "(?i)^(?=.*(?:bluray|blu-ray))(?!.*remux)",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gq",
      "id": "q-w",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/webdl-black.png",
      "isEnabled": true,
      "name": "WEB-DL",
      "pattern": "(?i)\\bweb[-_. ]?dl\\b",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gq",
      "id": "q-wr",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/webrip-black.png",
      "isEnabled": true,
      "name": "WEBRip",
      "pattern": "(?i)\\bweb[-_. ]?rip\\b",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gq",
	  "id": "q-hdtv",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/HDTV.svg",
      "isEnabled": true,
      "name": "HDTV",
      "pattern": "(?i)\\bhdtv\\b",
      "tagColor": "#00000000",
      "tagStyle": "filled",
      "textColor": "#00000000",
      "type": "filter"
    },
    {
      "borderColor": "#00000000",
      "groupId": "gq",	  
      "id": "q-dvd-scr",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/DVDScr.svg",
      "isEnabled": true,	  
      "name": "DVDScr",
	  "pattern": "(?i)\\bdvd[\\s._-]?scr(?:eener)?\\b",
      "tagColor": "#00000000",
      "tagStyle": "filled",
      "textColor": "#00000000",
      "type": "filter"
    },	
    {
      "borderColor": "#00000000",
      "groupId": "gq",	  
      "id": "q-dvd-rip",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/DVDRip.svg",
      "isEnabled": true,	  
      "name": "DVD RIP",
      "pattern": "(?i)\\b(dvd[\\s._-]?rip|dvdrip)\\b",
      "tagColor": "#00000000",
      "tagStyle": "filled",
      "textColor": "#00000000",
      "type": "filter"
    },
    {
      "borderColor": "#00000000",
      "groupId": "gq",	  
      "id": "q-cam",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/CAM.svg",
      "isEnabled": true,	  
      "name": "CAM",
	  "pattern": "(?i)^(?=.*(?:\\b(?:hd[-_. ]?)?cam(?:[-_. ]?rip)?\\b|\\b(?:hd[-_. ]?)?ts(?:[-_. ]?rip)?\\b|\\btelesync\\b|\\bpdvd\\b|\\b(?:hd[-_. ]?)?tc(?:[-_. ]?rip)?\\b|\\btelecine\\b|(?<!dvd)(?<!dvd[._-])\\bscr(?:eener)?\\b))(?!.*\\bdvd[\\s._-]?scr)",
      "tagColor": "#00000000",
      "tagStyle": "filled",
      "textColor": "#00000000",
      "type": "filter"
    },	
    {
      "borderColor": "#FFFFFF",
      "groupId": "gv",
      "id": "q-seadex",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/SEADEX-black.png",
      "isEnabled": true,
      "name": "SeaDex",
      "pattern": "(?i)\\b(?:seadex|best[\\s._-]?release|alt[\\s._-]?(?:best[\\s._-]?)?release)\\b|ᴀʟᴛ ʀᴇʟᴇᴀsᴇ|ʙᴇsᴛ ʀᴇʟᴇᴀsᴇ",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
   {
      "borderColor": "#FFFFFF",
      "groupId": "gr",
      "id": "r-4k",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/4k.png",
      "isEnabled": true,
      "name": "4K",
      "pattern": "(?i)^(?=.*(?:2160[pi]?|4k|uhd))(?!.*(?:1080[pi]?|720[pi]?))",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gr",
      "id": "r-1080",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/1080p.svg",
      "isEnabled": true,
      "name": "1080p",
      "pattern": "(?i)\\b1080[pi]?\\b",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gr",
      "id": "r-720",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/720p.svg",
      "isEnabled": true,
      "name": "720p",
      "pattern": "(?i)\\b720[pi]?\\b",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gr",
      "id": "r-480",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/480p.svg",
      "isEnabled": true,
      "name": "480p",
      "pattern": "(?i)\\b480[pi]?\\b",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gv",
      "id": "v-imax",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/IMAXv2.PNG",
      "isEnabled": true,
      "name": "IMAX",
      "pattern": "(?i)^(?=.*\\bIMAX\\b)(?!.*enhanced)",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
	{
      "borderColor": "#FFFFFF",
      "groupId": "gv",
      "id": "v-imax-enhanced",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/IMAX-enhanced.svg",
      "isEnabled": true,
      "name": "IMAX Enhanced",
	  "pattern": "(?i)\\b(imax[\\s._-]*enhanced)\\b",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gv",
      "id": "v-dv",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/DV.png",
      "isEnabled": true,
      "name": "DV (no HDR)",
	  "pattern": "(?i)^(?=.*\b(?:dv|dovi|dolby[\s._-]?vision)\b)(?!.*\b(?:hdr|hdr10(?:\+|plus|p)?|hlg)\b)",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gv",
      "id": "v-hdr10p",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/HDR10Plus.png",
      "isEnabled": true,
      "name": "HDR10+",
      "pattern": "(?i)^(?!.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b)(?=.*hdr[\\s._-]?10[\\s._-]?(?:\\\\+|plus|p))",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gv",
      "id": "v-hdr10",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/HDR10.png",
      "isEnabled": true,
      "name": "HDR10",
      "pattern": "(?i)^(?!.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b)(?=.*hdr[\\s._-]?10)(?!.*hdr[\\s._-]?10[\\s._-]?(?:\\\\+|plus|p))",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gv",
      "id": "v-hdr",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/HDR.png",
      "isEnabled": true,
      "name": "HDR",
      "pattern": "(?i)^(?!.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b)(?=.*\\bHDR\\b)(?!.*hdr[\\s._-]?10)",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
	{
      "borderColor": "#FFFFFF",
      "groupId": "gv",
      "id": "v-sdr",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/sdr.png",
      "isEnabled": true,
      "name": "SDR",
      "pattern": "(?i)^(?=.*(?:\\.(?:mkv|mp4|avi|mov|m4v|ts)\\b|\\b(?:x264|x265|xvid|h[ ._-]?264|h[ ._-]?265|hevc|avc|web[-_. ]?dl|webrip|blu[-_. ]?ray|bd[-_. ]?remux|bdremux|remux|bdrip|bdmux|dvd|dvdrip|hdtv|uhd|4k)\\b))(?!.*(?:^|[^A-Za-z0-9])(?:dovi|dv|dolby[ ._-]?vision|hdr10(?:\\+|plus|p)?|hdr[ ._-]?10[ ._-]?(?:\\+|plus|p)?|hdr|hlg)(?=$|[^A-Za-z0-9])).*$",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter",
    },
	{
      "borderColor": "#FFFFFF",
      "groupId": "gv",
      "id": "v-10bit",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/10bit.svg",
      "isEnabled": true,
      "name": "10bit",
      "pattern": "(?i)\\b10[\\s._-]?bit\\b",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter",
    },	
    {
      "borderColor": "#00000000",
      "groupId": "gc",
      "id": "c-av1",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/AV1.svg",
      "isEnabled": true,
      "name": "AV1",
	  "pattern": "(?i)\\bav1\\b",
      "tagColor": "#00000000",
      "tagStyle": "filled",
      "textColor": "#00000000",
      "type": "filter"
    },	
    {
      "borderColor": "#00000000",
      "groupId": "gc",
      "id": "c-hevc",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/HEVC.svg",
      "isEnabled": true,
      "name": "HEVC",
      "pattern": "(?i)\\b(hevc|h[\\s._-]?265|x265)\\b",
      "tagColor": "#00000000",
      "tagStyle": "filled",
      "textColor": "#00000000",
      "type": "filter"
    },
    {
      "borderColor": "#00000000",
      "groupId": "gc",
      "id": "c-h264",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/H264.svg",
      "isEnabled": true,
      "name": "h264",
	  "pattern": "(?i)\\b(?:avc|h[\\s._-]?264|x264)\\b",
      "tagColor": "#00000000",
      "tagStyle": "filled",
      "textColor": "#00000000",
      "type": "filter"
    },	
    {
      "borderColor": "#FFFFFF",
      "groupId": "ga",
      "id": "a-th",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/TrueHD.png",
      "isEnabled": true,
      "name": "TrueHD",
      "pattern": "(?i)(?:\\btrue[ ._-]?hd\\b|^(?=.*\\batmos\\b)(?=.*\\bremux\\b)(?!.*\\b(?:true[ ._-]?hd|ddp|dd\\+|e-?ac3|eac3)\\b).+$)",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "ga",
      "id": "a-at",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/Atmos.png",
      "isEnabled": true,
      "name": "Atmos",
      "pattern": "(?i)^(?!.*\\btrue[ _\\.\\-]?hd\\b).*\\batmos\\b.*$",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "ga",
      "id": "a-dtsx",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/dtsx.png",
      "isEnabled": true,
      "name": "DTS:X",
      "pattern": "(?i)\\bdts[-_.: ]?x\\b",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "ga",
      "id": "a-dtsma",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/dtsHDMA.png",
      "isEnabled": true,
      "name": "DTS-HD MA",
      "pattern": "(?i)^(?=.*\\bdts[-_. ]?(?:hd[-_. ]?)?ma\\b)(?!.*\\bdts[-_.: ]?x\\b)",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "ga",
      "id": "a-dtshd",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/dtsHD.png",
      "isEnabled": true,
      "name": "DTS-HD",
      "pattern": "(?i)^(?=.*\\bdts[-_. ]?hd\\b)(?!.*\\bdts[-_. ]?(?:hd[-_. ]?)?ma\\b)(?!.*\\bdts[-_.: ]?x\\b)",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "ga",
      "id": "a-dts",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/dts.png",
      "isEnabled": true,
      "name": "DTS",
      "pattern": "(?i)^(?=.*\\bDTS\\b)(?!.*\\bdts[-_. ]?(?:hd|ma|xll|x)\\b)",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "ga",
      "id": "a-dp",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/DDPLUS.png",
      "isEnabled": true,
      "name": "DD+",
      "pattern": "(?i)^(?=.*(?:\\bddp|\\bdd\\+|\\beac-?3|\\be-?ac-?3))(?!.*\\batmos\\b)(?!.*\\btrue[\\s._-]?hd\\b)(?!.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b)",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "ga",
      "id": "a-dd",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/DD.png",
      "isEnabled": true,
      "name": "DD",
      "pattern": "(?i)^(?=.*\\b(?:dd[25][. ][01]|dd[^p+a-z]\\b|\\bac-?3)\\b)(?!.*(?:\\bddp|\\bdd\\+|\\beac-?3|\\be-?ac-?3))(?!.*\\btrue[\\s._-]?hd\\b)(?!.*\\batmos\\b)(?!.*\\b(?:dv|dovi|dolby[\\s._-]?vision)\\b)",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gch",
      "id": "ch-71",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/71.png",
      "isEnabled": true,
      "name": "7.1",
      "pattern": "[^0-9][7-8][. ][01](?![0-9])",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gch",
      "id": "ch-61",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/61.png",
      "isEnabled": true,
      "name": "6.1",
      "pattern": "(?i)(?=.*[^0-9]6[ .][0-1]\\b)(?!.*[^0-9][7-8][ .][0-1]\\b)(?!.*[^0-9]5[ .][0-1]\\b)(?!.*(?<!repac)[^0-9][1-4][ .][0-1]\\b|\\\\b(Stereo|Mono)\\\\b)",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    },
    {
      "borderColor": "#FFFFFF",
      "groupId": "gch",
      "id": "ch-51",
      "imageURL": "https://raw.githubusercontent.com/medinauta/Streaming/main/Nuvio/Badges/Min/51.png",
      "isEnabled": true,
      "name": "5.1",
      "pattern": "^(?=.*[^0-9]5[. ][01](?![0-9]))(?!.*[^0-9][7-8][. ][01](?![0-9]))",
      "tagColor": "#FFFFFF",
      "tagStyle": "filled",
      "textColor": "#000000",
      "type": "filter"
    }
  ]
}
